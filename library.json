{
  "name": "Bluetooth BLE",
  "version": "2.0.0",
  "license": "GPL-3.0-or-later",
  "keywords": "bluetooth, esp, arduino",
  "description": "Read and write datas from bluetooth client and server, with scanner",
  "repository":
  {
    "type": "git",
    "url": "https://github.com/DeathManOne/Bluetooth"
  },
  "frameworks": "arduino",
  "platforms": ["espressif32"],
  "build": {
    "flags": [
      "-DBLUETOOTH_REGISTRY_WRAPPING=1",
      "-DBLUETOOTH_REMOTE_CLEANUP_WRAPPING=1",
      "-Wl,--wrap=_ZN9BLEDevice13addPeerDeviceEPvbt",
      "-Wl,--wrap=_ZN9BLEDevice16updatePeerDeviceEPvbt",
      "-Wl,--wrap=_ZN9BLEDevice16removePeerDeviceEtb",
      "-Wl,--wrap=_ZN23BLERemoteCharacteristicD1Ev"
    ]
  }
}
